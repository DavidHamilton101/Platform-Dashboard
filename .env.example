# Copy this file to .env.development, .env.staging, or .env.production
# and fill in real values. Never commit files with real values.

# Anthropic Admin API — read-only usage/cost scope only
ANTHROPIC_ADMIN_API_KEY=sk-ant-admin-xxxxxxxxxxxxxxxxxxxx

# Supabase — server-side only, never expose in client code
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Internal API bearer token for the dashboard
DASHBOARD_API_KEY=your-dashboard-api-key-here

# Webhook URL for cost and security alerts (e.g. Slack incoming webhook)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Cost alert threshold in USD — alert fires when daily spend exceeds this
COST_ALERT_THRESHOLD_USD=100

# Runtime environment identifier
ENVIRONMENT=development
